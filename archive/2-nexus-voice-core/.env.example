# Copy this file to `.env` and fill in your keys. `.env` is git-ignored — never commit real keys.
# Only ANTHROPIC_API_KEY is needed for Tier 1 (the text brain). The others come online in Tier 3 (voice).

ANTHROPIC_API_KEY=

# Tier 3 — speech-to-text (Deepgram) and text-to-speech (ElevenLabs). Leave blank until then.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
