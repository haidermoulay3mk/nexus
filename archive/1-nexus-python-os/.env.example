# Copy to .env and adjust. All values are optional; sensible defaults are used.

# Where Nexus stores its data (DB, vectors, logs, tokens, backups).
# Default on Windows: %LOCALAPPDATA%\Nexus
# NEXUS_HOME=C:\Users\you\AppData\Local\Nexus

# Ollama HTTP endpoint (the local model runtime).
# OLLAMA_HOST=http://localhost:11434

# Override the model used for each tier (otherwise taken from config.toml).
# NEXUS_MODEL_FAST=llama3.2:1b
# NEXUS_MODEL_BALANCED=qwen2.5:3b-instruct
# NEXUS_MODEL_REASONING=qwen2.5:7b-instruct
# NEXUS_MODEL_EMBED=nomic-embed-text
