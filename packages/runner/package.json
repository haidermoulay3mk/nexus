    "@nexus/plugin-sdk": "workspace:*",
    "@nexus/plugin-academics": "workspace:*",
    "@nexus/plugin-agency": "workspace:*",
    "@nexus/plugin-calendar": "workspace:*",
    "@nexus/plugin-courses": "workspace:*",
    "@nexus/plugin-email": "workspace:*",
    "@nexus/plugin-intel": "workspace:*",
    "@nexus/plugin-metrics": "workspace:*",
    "@nexus/plugin-notion": "workspace:*",
    "@nexus/plugin-ops": "workspace:*",
    "@nexus/plugin-reports": "workspace:*",
    "@nexus/plugin-scholarships": "workspace:*",
    "ai": "^4.1.0",
    "croner": "^9.0.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
